# Cloudflare Turnstile site key for agniguard.tigersh19991.workers.dev. Public by
# design: it ships in every visitor's page. The matching secret is a Worker secret
# (TURNSTILE_SECRET), never in this repo. Dev builds use Cloudflare's always-pass
# test key instead.
# TEMPORARY: Cloudflare's always-pass test key, so the site works before a real widget
# is created. Replace with your own widget's site key (Cloudflare dashboard -> Turnstile).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
